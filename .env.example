# Copy to .env and fill in real values for local development.

ENVIRONMENT=development

# Postgres 16 + pgvector. Matches docker-compose.yml defaults.
DATABASE_URL=postgresql+asyncpg://compliance:compliance@localhost:5432/compliance_copilot

# DeepSeek (OpenAI-compatible API) — powers the LangGraph agent's reasoning nodes.
# Required from Phase 5 onward; not needed for ingestion or retrieval-only work.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# BGE-M3 embedding model id (HuggingFace), used for dense + sparse retrieval.
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# Langfuse tracing. Required from Phase 5 onward.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Retrieval tunables — defaults here are starting points, tuned against eval/ in Phase 5.
RETRIEVAL_TOP_K=10
RETRIEVAL_FUSION_WEIGHT=0.5
RETRIEVAL_RELEVANCE_FLOOR=0.35

API_HOST=0.0.0.0
API_PORT=8000
