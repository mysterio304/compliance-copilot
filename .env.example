# Copy to .env and fill in real values for local development.

ENVIRONMENT=development

# Postgres 16 + pgvector. Host port is 5433 (see docker-compose.yml) to avoid
# colliding with a locally-installed Postgres on the default 5432.
DATABASE_URL=postgresql+asyncpg://compliance:compliance@localhost:5433/compliance_copilot

# DeepSeek (OpenAI-compatible API) — powers the LangGraph agent's reasoning nodes.
# Required from Phase 5 onward; not needed for ingestion or retrieval-only work.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# BGE-M3 embedding model id (HuggingFace), used for dense + sparse retrieval.
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# Langfuse tracing. Required from Phase 5 onward.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Retrieval tunables — chosen by sweeping scripts/tune_retrieval.py against
# the eval harness (Phase 5), not by intuition. See config.py for the full
# rationale, including a documented interaction where fusion_weight is
# currently inert at this relevance_floor.
RETRIEVAL_TOP_K=5
RETRIEVAL_FUSION_WEIGHT=0.5
RETRIEVAL_RELEVANCE_FLOOR=0.35

API_HOST=0.0.0.0
API_PORT=8000
